# ==========================================
# COMMODITY. - Mẫu biến môi trường (.env.example)
# ==========================================

# 1. Khóa API Google Gemini (Dùng cho máy chủ node serve.mjs để bật AI "Hỏi Chiếc Áo")
# Lấy API key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Cổng chạy máy chủ tĩnh (Tùy chọn, mặc định 3000)
# PORT=3000

# 3. Địa chỉ API Backend khi chạy chế độ phát triển dev (Tùy chọn)
# Khi chạy `npm run dev` ở port 3000 và chạy `PORT=3001 node serve.mjs` ở cửa sổ khác:
# NEXT_PUBLIC_API_BASE=http://localhost:3001
